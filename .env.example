# =============================================================================
# EIT App — Variables de Entorno
# =============================================================================
# Copia este archivo a .env y completa los valores según tu entorno.
#   cp .env.example .env
# =============================================================================

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=genera-una-clave-unica-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:7860

# ── Base de Datos (default) ─────────────────────────────────────────────────
# Local (Docker compose): postgres://eit_user:eit_password@db:5432/eit_app
# Local (nativo):         postgres://postgres:1234@localhost:5432/eitapp
# VPS (Coolify):          lo setea Coolify automáticamente
DATABASE_URL=postgresql://postgres:1234@localhost:5432/eitapp

# ── VPS Oracle (para switcheo multi-DB) ─────────────────────────────────────
# Se usa cuando DATABASE_URL no está disponible (ej: VPS con Coolify).
# DATABASE_URL_ORA=postgres://user:password@host:5432/dbname
# O en vars separadas:
# user=
# password=
# host=
# port=5432
# dbname=

# ── PostgreSQL Local (para switcheo desde ORA) ──────────────────────────────
# DATABASE_URL_LOCAL=postgresql://postgres:1234@localhost:5432/eitapp

# ── Almacenamiento (imágenes de proyecto/nodo) ──────────────────────────────
# Almacenamiento local en volumen Docker persistente (MEDIA_ROOT=/app/media).
# No requiere configuración adicional.

# ── API Keys ────────────────────────────────────────────────────────────────
# CONTEXT7_API_KEY=
